# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=event_ticketing

# Frontend on http://127.0.0.1:3001
FRONTEND_PORT=3001

# Feature profile: sprint2, sprint3, sprint4, final.
# Override one flag with FEATURE_<NAME>=on|off, e.g. FEATURE_TICKET_LIMIT=on.
FEATURE_PROFILE=sprint2

# Show customer login codes on screen (no SMS/email provider yet).
OTP_DEMO=true
# Send phone login codes to the COSH301 OTP Android app (see docs/otp-app.md).
# Takes precedence over OTP_DEMO for phone numbers; email codes are unchanged.
OTP_APP_DELIVERY=false
# Set to true when served over HTTPS.
COOKIE_SECURE=false

# production disables one-click demo login and demo data reset.
APP_ENV=development

# Public address of the site, no trailing slash. VNPay sends the browser back to
# $PUBLIC_URL/payment/vnpay/return unless VNPAY_RETURN_URL is set.
# PUBLIC_URL=https://cosh301.example.com

# Dynamic pricing (FR-22, flag dynamic_pricing). All optional; see docs/dynamic-pricing.md.
# PRICING_INTERVAL_SECONDS=300          # how often every event on sale is analyzed
# PRICING_WINDOW_MINUTES=15             # sliding window for sales velocity
# PRICING_REJECT_COOLDOWN_MINUTES=60    # a rejected suggestion stays quiet for this long
# For a demo: the target pace assumes at most this many minutes left, so a few holds move the price.
# Leave unset in production (the target then follows the real end of sales).
# PRICING_TARGET_HORIZON_MINUTES=60

# VNPay sandbox payment. Turn it on with FEATURE_PAYMENTS=on (or a profile that
# includes payments). With it on, the API refuses to start without the two
# credentials below, which come from the VNPay merchant sandbox.
# FEATURE_PAYMENTS=on
# VNPAY_TMN_CODE=
# VNPAY_HASH_SECRET=
# VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# VNPAY_RETURN_URL=

# Assistant chatbot (flag `chatbot`, on by default). With LLM_BASE_URL empty it answers
# from keywords only. Any OpenAI-compatible server works; see docs/assistant.md.
# LLM_BASE_URL=https://cosh301-llm.example.com/v1
# LLM_MODEL=cosh301-assistant
# LLM_API_KEY=

# Public access through Cloudflare Tunnel: enable the profile and set the token.
# COMPOSE_PROFILES=tunnel
# TUNNEL_TOKEN=
