# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=event_ticketing

# Frontend on http://127.0.0.1:3001
FRONTEND_PORT=3001

# Feature profile: sprint2, sprint3, sprint4, final.
# Override one flag with FEATURE_<NAME>=on|off, e.g. FEATURE_TICKET_LIMIT=on.
FEATURE_PROFILE=sprint2

# Show customer login codes on screen (no SMS/email provider yet).
OTP_DEMO=true
# Set to true when served over HTTPS.
COOKIE_SECURE=false

# Public access through Cloudflare Tunnel: enable the profile and set the token.
# COMPOSE_PROFILES=tunnel
# TUNNEL_TOKEN=
