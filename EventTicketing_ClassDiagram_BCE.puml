}

' ==========================================
' ENTITY LAYER (tham chiếu rút gọn — xem chi tiết tại
' EventTicketing_ClassDiagram_Core.puml)
' ==========================================
package "Entity Layer (xem chi tiết ở diagram Core)" #F3E5F5 {
    class User {
        -id: UUID
        -phone: String
        -role: Enum
    }
    class OtpVerification {
        -id: UUID
        -purpose: String
    }
    class Event {
        -id: UUID
        -name: String
        -status: Enum
    }
    class EventSeat {
        -id: UUID
        -status: Enum
        -currentPrice: Decimal
    }
    class ZonePriceRule {
        -id: UUID
        -floorPrice: Decimal
        -ceilingPrice: Decimal
    }
    class QueueEntry {
        -id: UUID
        -position: long
    }
    class BotChallenge {
        -id: UUID
        -riskScore: Decimal
    }
    class Order {
        -id: UUID
        -status: Enum
        -totalAmount: Decimal
    }
    class SeatHold {
        -id: UUID
        -status: Enum
        -expiresAt: DateTime
    }
    class PaymentTransaction {
        -id: UUID
        -provider: Enum
        -status: Enum
    }
    class PaymentReconciliation {
        -id: UUID
        -status: Enum
    }
    class Refund {
        -id: UUID
        -amount: Decimal
    }
    class Ticket {
        -id: UUID
        -ticketCode: String
        -status: Enum
    }
    class TicketQrToken {
        -id: UUID
        -validUntil: DateTime
    }
    class Checkin {
        -id: UUID
        -result: Enum
    }
    class GateDevice {
        -id: UUID
        -deviceCode: String
    }
    class Promotion {
        -id: UUID
        -code: String
    }
    class SalesSnapshot {
        -id: long
        -capturedAt: DateTime
    }
}

' ==========================================
' RELATIONSHIPS
' ==========================================

' Boundary -> Control
CustomerAuthUI ..> AuthController : gửi yêu cầu OTP
EventBrowsingUI ..> QueueController : vào hàng chờ khi quá tải
WaitingRoomUI ..> QueueController : truy vấn số thứ tự
SeatMapUI ..> SeatHoldController : lock / release ghế
SeatMapUI ..> AntiBotController : kiểm tra trước khi giữ ghế
CheckoutUI ..> OrderController : tạo đơn hàng
CheckoutUI ..> PaymentController : thanh toán
TicketDisplayUI ..> TicketController : hủy vé / tải vé
PaymentGatewayAdapter ..> PaymentController : gửi callback/webhook
GateScannerUI ..> CheckInController : quét & kiểm tra vé
OrganizerDashboardUI ..> PricingController : điều chỉnh trần/sàn
OrganizerDashboardUI ..> DashboardController : xem báo cáo

' Control -> Control
QueueController ..> AntiBotController
QueueController ..> SeatHoldController : cấp quyền truy cập sơ đồ ghế
SeatHoldController ..> OrderController : chuyển ghế giữ sang đơn hàng
OrderController ..> PaymentController : khởi tạo thanh toán
PaymentController ..> ReconciliationController : đối soát giao dịch
PaymentController ..> TicketController : phát hành vé
PricingController ..> SeatHoldController : áp dụng giá hiện tại

' Control -> Entity
AuthController ..> User
AuthController ..> OtpVerification
QueueController ..> QueueEntry
AntiBotController ..> BotChallenge
SeatHoldController ..> EventSeat
SeatHoldController ..> SeatHold
PricingController ..> ZonePriceRule
OrderController ..> Order
PaymentController ..> PaymentTransaction
ReconciliationController ..> PaymentReconciliation
ReconciliationController ..> Refund
TicketController ..> Ticket
TicketController ..> TicketQrToken
CheckInController ..> Checkin
CheckInController ..> GateDevice
DashboardController ..> SalesSnapshot

legend right
  |= Ký hiệu |= Ý nghĩa |
  | <<FR-xx>> | Yêu cầu chức năng tương ứng trong System design.docx |
  | "có code" | Đã hiện diện trong frontend/src |
  | "CHƯA có code (planned)" | Theo FR nhưng chưa triển khai |
  | ..> | Dependency (gọi / sử dụng) |
endlegend

@enduml
