        +deliverTicket(ticketId: String, channel: String): void
    }

    class CheckInController <<FR-16, FR-17, FR-18>> {
        +validateQrToken(tokenHash: String): boolean
        +recordCheckin(ticketId: String, gateDeviceId: String): Checkin
        +syncOfflineLogs(deviceCode: String, logs: List<Checkin>): boolean
    }

    class DashboardController <<FR-19, FR-21>> {
        +getRevenueByMinute(eventId: String): List<SalesSnapshot>
