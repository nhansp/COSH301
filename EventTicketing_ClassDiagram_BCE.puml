' ==========================================
' CONTROL LAYER (planned theo FR, chưa có backend)
' ==========================================
package "Control Layer (Application & Business Logic)" #E0F7FA {
    class AuthController <<FR-01, FR-04>> {
        +sendOtp(phone: String): boolean
        +verifyOtp(phone: String, code: String): boolean
        +createSession(user: User): String
    }

    class QueueController <<FR-09>> {
        +enqueue(userId: String, eventId: String): long
        +estimateWaitTime(position: long): int
        +admitNext(eventId: String): String
    }

    class AntiBotController <<FR-10, FR-11, NFR-07>> {
        +runChallenge(sessionId: String): String
        +checkTicketQuota(userId: String, eventId: String, max: int): boolean
    }

    class SeatHoldController <<FR-05, FR-06, FR-07>> {
        +getLiveSeatMap(eventId: String): List<EventSeat>
        +holdSeat(eventId: String, seatId: String, userId: String): boolean
        +releaseExpiredHolds(): void
    }

    class PricingController <<FR-08, FR-20, FR-22, FR-23>> {
        +setZonePriceRule(zoneId: String, floor: Decimal, ceiling: Decimal): void
        +adjustPrice(eventSeatId: String, newPrice: Decimal, source: String): void
    }

    class OrderController <<FR-13>> {
        +createOrder(userId: String, eventId: String, seatIds: List<String>): Order
        +applyPromotion(orderId: String, code: String): void
        +expireUnpaidOrder(orderId: String): void
    }

    class PaymentController <<FR-13, FR-14>> {
        +initiatePayment(orderId: String, provider: String): PaymentTransaction
        +handleWebhook(providerTxId: String, status: String): void
        +issueTickets(orderId: String): List<Ticket>
    }

    class ReconciliationController <<FR-15, NFR-04>> {
        +detectMismatch(): List<PaymentReconciliation>
        +resolveViaTicketIssue(reconId: String): void
        +resolveViaRefund(reconId: String): Refund
    }

    class TicketController <<FR-12, FR-14>> {
        +generateTicket(orderItemId: String): Ticket
